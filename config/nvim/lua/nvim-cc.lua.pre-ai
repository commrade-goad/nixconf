local M = {}

ModCwd = nil

Nvim_cc_term_buffn = nil

if Nvim_cc_split_size == nil then
    Nvim_cc_split_size = 15
end

if Nvim_cc_file_name == nil or Nvim_cc_file_name == "" then
    Nvim_cc_file_name = "nvim-cc.txt"
end

if Nvim_cc_blacklist_dir_name == nil or Nvim_cc_blacklist_dir_name == "" then
    Nvim_cc_blacklist_dir_name = { "src" }
end

if Nvim_cc_modcwd == nil or Nvim_cc_modcwd == "" then
    Nvim_cc_modcwd = ""
end

if Nvim_cc_start_insert == nil then
    Nvim_cc_start_insert = true
end

local vt_ns = vim.api.nvim_create_namespace("nvim-cc-virtual-jump")

function M.set_compile_command_from_file()
    local directory = vim.fn.getcwd(0, 0);

    for i = 1, #Nvim_cc_blacklist_dir_name, 1 do
        local item = Nvim_cc_blacklist_dir_name[i]
        if directory:sub(- #item - 1) == "/" .. item then
            directory = directory:sub(1, - #item - 2)
        end
    end

    local file_path = directory .. "/" .. Nvim_cc_file_name
    local success, file_content = pcall(vim.fn.readfile, file_path)

    if success and #file_content > 0 then
        Nvim_cc_compile_command = ""
        for index in pairs(file_content) do
            if string.sub(file_content[index], 1, 1) == "#" then
                local filtered_str = string.sub(file_content[index], 2, #file_content[index])
                filtered_str = filtered_str:match("^%s*(.-)%s*$")
                local read_func = load(filtered_str)
                if read_func then
                    read_func()
                    if ModCwd ~= nil then
                        Nvim_cc_modcwd = ModCwd
                        ModCwd = nil
                    end
                end
                goto continue
            end
            if Nvim_cc_compile_command ~= nil and Nvim_cc_compile_command ~= "" then
                Nvim_cc_compile_command = Nvim_cc_compile_command .. " && " .. file_content[index]
            else
                Nvim_cc_compile_command = file_content[index]
            end
            ::continue::
        end
        vim.opt_local.makeprg = Nvim_cc_compile_command
        print("nvim-cc : " .. Nvim_cc_compile_command)
    end
end

function M.input_compile_command()
    if Nvim_cc_compile_command == nil then
        Nvim_cc_compile_command = ""
    end
    local compile_command = vim.fn.input({
        prompt = "Enter Compile command : ",
        default = Nvim_cc_compile_command,
        completion = "shellcmd",
        wildchar = vim.api.nvim_replace_termcodes("<Tab>", true, false, true),
    })
    if compile_command ~= "" then
        Nvim_cc_compile_command = compile_command
    end
    vim.opt_local.makeprg = Nvim_cc_compile_command
end

local function parse_error_line(line, cwd)
    local file, lnum, col = line:match("(/?[^%s:]+):(%d+):(%d+)")
    if not col then
        file, lnum = line:match("(/?[^%s:]+):(%d+)")
        col = 1
    end

    if not file or not lnum then
        return {
            text = line,
        }
    end

    file = file:match("^%s*(.-)%s*$")
    file = file:match("([/A-Za-z%.][A-Za-z0-9/%.%-%_]*)")

    if not file then
        return { text = line }
    end

    if file:sub(1, 1) ~= "/" then
        file = cwd .. "/" .. file
    end

    return {
        filename = file,
        lnum = tonumber(lnum),
        col = tonumber(col),
        text = line,
    }
end

local function term_to_quickfix(term_buf, cwd)
    local lines = vim.api.nvim_buf_get_lines(term_buf, 0, -1, false)
    local items = {}

    for _, line in ipairs(lines) do
        if line:match("%S") then
            table.insert(items, parse_error_line(line, cwd))
        end
    end

    vim.fn.setqflist({}, "r", {
        title = "nvim-cc",
        items = items,
    })
end

function M.run_compile_command()
    if not Nvim_cc_compile_command or Nvim_cc_compile_command == "" then
        print("There is no compile command specified!")
        return
    end

    local split_mode = (Nvim_cc_vsplit_mode and "vsplit") or "split"
    local cmd = Nvim_cc_split_size .. split_mode .. " | terminal " .. Nvim_cc_compile_command

    vim.cmd(cmd)

    local term_buf = vim.api.nvim_get_current_buf()
    Nvim_cc_term_buffn = term_buf
    vim.keymap.set("n", "<CR>", function()
        M.jump_to_error_position()
    end, {
        buffer = term_buf,
        silent = true,
        desc = "nvim-cc: jump to error",
    })

    local old_cwd = vim.fn.getcwd()
    local new_cwd = old_cwd .. "/" .. (Nvim_cc_modcwd or "")

    vim.api.nvim_create_autocmd("CursorMoved", {
        buffer = term_buf,
        callback = function()
            local row = vim.api.nvim_win_get_cursor(0)[1] - 1
            local line = vim.api.nvim_buf_get_lines(term_buf, row, row + 1, false)[1]
            if last_mark then
                pcall(vim.api.nvim_buf_del_extmark, term_buf, vt_ns, last_mark)
                last_mark = nil
            end

            if line and line:match("(/?[^%s:]+):(%d+)") then
                vim.wo.cursorline = true
                last_mark = vim.api.nvim_buf_set_extmark(term_buf, vt_ns, row, 0, {
                    virt_text = { { "<CR>", "Comment" } },
                    -- virt_text_pos = "eol",
                    virt_text_pos = "right_align",
                })
            else
                vim.wo.cursorline = false
            end
        end,
    })
    vim.api.nvim_create_autocmd("TermClose", {
        buffer = term_buf,
        once = true,
        callback = function()
            term_to_quickfix(term_buf, new_cwd)
            vim.cmd("cd " .. old_cwd)
        end,
    })

    if Nvim_cc_start_insert then
        vim.cmd("startinsert")
    end
end

function M.sync_directory_to_buffer()
    if vim.bo.filetype == 'netrw' or vim.b.netrw_bufnr then
        return
    end
    local current_buffer = vim.api.nvim_get_current_buf()
    local current_file = vim.api.nvim_buf_get_name(current_buffer)
    local directory = vim.fn.fnamemodify(current_file, ":h")

    for i = 1, #Nvim_cc_blacklist_dir_name, 1 do
        local item = Nvim_cc_blacklist_dir_name[i]
        if directory:sub(- #item - 1) == "/" .. item then
            directory = directory:sub(1, - #item - 2)
        end
    end

    vim.cmd('cd ' .. directory)
    print('cwd : ' .. directory)
end

function M.export_compile_command()
    local file = io.open(Nvim_cc_file_name, "w")
    if file ~= nil then
        file:write(Nvim_cc_compile_command)
        print("Saved " .. Nvim_cc_file_name)
        file:close()
    else
        print("Failed to export " .. Nvim_cc_file_name)
    end
end

function M.jump_to_error_position()
    local old_cwd = vim.fn.getcwd()
    local new_cwd = vim.fn.getcwd() .. "/" .. Nvim_cc_modcwd
    local line = vim.fn.getline(".")
    local file, line_num, col_num = line:match("(/?[^%s:]+):(%d+):(%d+)")
    if col_num == nil or col_num == "" then
        file, line_num = line:match("(/?[^%s:]+):(%d+)")
        col_num = 1
    end
    if file and line_num then
        -- `0` to get the current one
        for _, win in ipairs(vim.api.nvim_tabpage_list_wins(0)) do
            local buf = vim.api.nvim_win_get_buf(win)
            if buf ~= Nvim_cc_term_buffn then
                vim.api.nvim_set_current_win(win)
                break
            end
        end

        vim.cmd("cd " .. new_cwd)
        file = file:match("^%s*(.-)%s*$")
        file = file:match("([/A-Za-z%.][A-Za-z0-9/%.%-%_]*)")
        local filec = file
        if string.sub(file, 1, 1) ~= '/' then
            filec = vim.fn.getcwd() .. "/" .. file
        end
        -- `0` to get the current one
        if vim.api.nvim_buf_get_name(0) ~= filec then
            local file_check = io.open(filec, "r")
            if file_check == nil then
                print("nvim-cc : file `" .. file .. "` doesn't exist!.")
                vim.cmd("cd " .. old_cwd)
                return
            end
            vim.cmd("edit " .. file)
            io.close(file_check)
        end

        vim.api.nvim_win_set_cursor(0, { tonumber(line_num), tonumber(col_num) - 1 })
        vim.cmd("cd " .. old_cwd)
    else
        print("nvim-cc : not a valid jump pattern.")
    end
end

vim.api.nvim_create_user_command("Compile", function(opts)
    local cmd = table.concat(opts.fargs, " ")
    if cmd ~= "" then
        Nvim_cc_compile_command = cmd
        vim.opt_local.makeprg = cmd
        M.run_compile_command()
    end
end, {
    nargs = "+",
    complete = "shellcmd"
})

vim.api.nvim_create_user_command("Recompile", function(opts)
    if Nvim_cc_compile_command ~= "" then
        M.run_compile_command()
    end
end, {})

function M.default_setup()
    Nvim_cc_start_insert = false
    Nvim_cc_blacklist_dir_name = {"src", "bin"}

    vim.keymap.set("n", "<leader>cC", function()
        M.input_compile_command()
    end, { desc = "Input Compile Command" })
    vim.keymap.set("n", "<leader>cc", function()
        if Nvim_cc_term_buffn ~= nil and vim.fn.bufexists(Nvim_cc_term_buffn) == 1 then
            vim.api.nvim_buf_delete(Nvim_cc_term_buffn, { force = true })
        end
        M.run_compile_command()
    end, { desc = "Run Compile Command" })
    vim.keymap.set("n", "<leader>co", function() Nvim_cc_compile_command = "" end, { desc = "Clear compile command" })
    vim.keymap.set("n", "<leader>cf", function() M.set_compile_command_from_file() end, { desc = "Set Compile Command From File" })
    vim.keymap.set("n", "<leader>cs", function()
        M.sync_directory_to_buffer()
        M.set_compile_command_from_file()
    end, { desc = "Sync Directory & Set Compile Command" })
    vim.keymap.set("n", "<leader>cw", function() M.export_compile_command() end, { desc = "Export Compile Command" })
    vim.keymap.set("n", "<leader>cj", function() M.jump_to_error_position() end, { desc = "Jump to Error Position" })
end

return M
