;; (setq diff-refine nil)                         ;; disable char hl on diff (def value if font-lock)
(setq magit-diff-refine-hunk t)                   ;; magit show char diff (no whitespace)
;; (set-frame-parameter nil 'alpha-background 98)
;; (setq display-line-numbers-type 'relative)
;; (setq display-line-numbers-width 3)

(setq treesit-font-lock-level 2)               ;; less syntax hl
(setq make-backup-files nil)                   ;; ~
(setq create-lockfiles nil)                    ;; #
(setq column-number-mode t)                    ;; for the line number and stuff
(setq dired-dwim-target t)
(setq frame-resize-pixelwise t)
(setq ring-bell-function 'ignore)
;; (setq completion-styles '(flex basic)
(setq completion-styles '(basic partial-completion))
(setq completion-ignore-case t
      read-file-name-completion-ignore-case t
      read-buffer-completion-ignore-case t)
(savehist-mode 1)

(setq gc-cons-threshold 16000000)

(unless (display-graphic-p) (xterm-mouse-mode 1))

(setq-default c-ts-mode-indent-offset 4
              c-ts-mode-indent-style 'gnu
              tab-width 4
              indent-tabs-mode nil)
(setq-default tab-always-indent 'complete)

(require 'ansi-color)

(defun colorize-compilation-buffer ()
  (when compilation-filter-start
    (ansi-color-apply-on-region compilation-filter-start (point))))

(defun create-temp-buffer ()
  "create a temp buffer"
  (interactive)
  (switch-to-buffer "*temp*"))

(defun my-ts-indent-4 ()
  (setq-local tab-width 4)
  (setq-local indent-tabs-mode nil)

  (when (derived-mode-p 'c-ts-mode 'c++-ts-mode)
    (setq-local c-ts-mode-indent-offset 4)))

(add-hook 'treesit-major-mode-hook #'my-ts-indent-4)

(add-hook 'compilation-filter-hook 'colorize-compilation-buffer)

;; (add-hook 'text-mode-hook 'display-line-numbers-mode)
(add-hook 'prog-mode-hook
          (lambda ()
            (setq-local bidi-display-reordering nil
                        bidi-inhibit-bpa t
                        show-trailing-whitespace t)
            ;; (display-line-numbers-mode 1)
            (editorconfig-mode 1)))

(add-to-list 'default-frame-alist `(font . "CodeNewRoman Nerd Font Mono 14"))

(add-to-list 'custom-theme-load-path (expand-file-name "fuuted/" user-emacs-directory))
(load-theme 'fuuted t)

(defun my/reload-fuuted-theme ()
  "Fully reload the fuuted theme from disk."
  (interactive)
  (mapc #'disable-theme custom-enabled-themes)
  (when (featurep 'fuuted-theme)
    (unload-feature 'fuuted-theme t))
  (load-theme 'fuuted t))

(add-to-list 'load-path (expand-file-name "simpc-mode/" user-emacs-directory))
(require 'simpc-mode)

(add-to-list 'auto-mode-alist '("\\.[hc]\\(pp\\)?\\'" . simpc-mode))
(add-to-list 'auto-mode-alist '("\\.epub" . nov-mode))
(add-to-list 'auto-mode-alist '("\\.ts" . typescript-ts-mode))
(add-to-list 'auto-mode-alist '("\\.tsx" . tsx-ts-mode))

(setq major-mode-remap-alist
      '((c-mode . c-ts-mode)
        (c++-mode . c++-ts-mode)
        (c-or-c++-mode . c-or-c++-ts-mode)
        ))

;; TRAMP stuff
(setq remote-file-name-inhibit-locks t
      tramp-use-scp-direct-remote-copying t
      remote-file-name-inhibit-auto-save t)

(connection-local-set-profile-variables
 'remote-direct-async-process
 '((tramp-direct-async-process . t)))

(connection-local-set-profiles
 '(:application tramp :protocol "scp")
 'remote-direct-async-process)
(setq tramp-default-method "scp")


;; latex setup
(define-minor-mode latex-auto-compile-mode
  "Auto compile LaTeX on save using latexmk."
  :lighter " AutoLaTeX"
  (if latex-auto-compile-mode
      (add-hook 'after-save-hook #'latex-auto-compile--run nil t)
    (remove-hook 'after-save-hook #'latex-auto-compile--run t)))

(defvar latex-auto-compile--process nil)

(defun latex-auto-compile--run ()
  (when (and (eq major-mode 'latex-mode)
             (buffer-file-name)
             (not (process-live-p latex-auto-compile--process)))
    (setq latex-auto-compile--process
          (start-process
           "latexmk" "*latexmk*"
           "latexmk" "-pdf" "-silent"
           (buffer-file-name)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; 2. PACKAGE MANAGER SETUP ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(require 'package)
(add-to-list 'package-archives '("gnu" . "https://elpa.gnu.org/packages/") t)
(add-to-list 'package-archives '("melpa" . "https://melpa.org/packages/") t)

(package-initialize)

(unless (package-installed-p 'use-package)
  (package-refresh-contents)
  (package-install 'use-package))

(require 'use-package)
(setq use-package-always-ensure t)

;;;;;;;;;;;;;;;;;;;;
;; 3. THE PACKAGE ;;
;;;;;;;;;;;;;;;;;;;;

(use-package xclip
  :defer t
  :init
  (xclip-mode 1))

(use-package vertico
  :defer t
  :init
  (vertico-mode 1)
  (setq vertico-cycle t
        vertico-sort-function #'vertico-sort-history-alpha))

(setq vterm-max-scrollback 5000)
(use-package vterm
  :defer t
  :ensure t)

(use-package magit
  :defer t
  :init)

(use-package markdown-mode
  :defer t)

(use-package web-mode
  :defer t)

(use-package php-mode
  :defer t)

(add-to-list 'auto-mode-alist '("\\.html?\\'" . web-mode))
(add-to-list 'auto-mode-alist '("\\.vue\\'" . web-mode))
(add-to-list 'auto-mode-alist '("\\.blade\\.php\\'" . web-mode))

(use-package nov
  :defer t)

(setq read-process-output-max (* 1024 1024))
(fset #'jsonrpc--log-event #'ignore)
(setq eglot-events-buffer-config '(:size 0 :format short))
(setq eglot-sync-connect nil)
(remove-hook 'jsonrpc-event-hook 'jsonrpc--log-event)

(setq eglot-ignored-server-capabilities '(:inlayHintProvider
                                          ;; :hoverProvider
                                          :signatureHelpProvider
                                          :documentHighlightProvider
                                          :codeLensProvider
                                          :documentFormattingProvider
                                          :documentRangeFormattingProvider
                                          :documentOnTypeFormattingProvider
                                          :executeCommandProvider))

(use-package eglot
  :defer t)

(with-eval-after-load 'eglot
  (add-to-list 'eglot-server-programs
               '(simpc-mode . ("clangd"
                               "--background-index"
                               "--clang-tidy"
                               "--header-insertion=never"))))

;; (add-hook 'go-ts-mode-hook 'eglot-ensure)

(setq cape-dabbrev-min-length 2)
(setq cape-dabbrev-limit 5)
(setq dabbrev-other-buffers t)

(use-package cape
  :ensure t
  :config
  (defun my/cape-capf-setup-super ()
    "Grab all existing Capfs, add dabbrev/file, and wrap them in a super-Capf."
    (let ((current-capfs (remove t completion-at-point-functions)))
      ;; Add dabbrev and file to the list we just grabbed
      (add-to-list 'current-capfs #'cape-dabbrev t)
      (add-to-list 'current-capfs #'cape-file t)

      ;; Now overwrite the local list with a single super-capf containing everything
      (setq-local completion-at-point-functions
                  (list (apply #'cape-capf-super (delete-dups current-capfs))))))

  ;; We run this at the end of hooks (depth 100) so that Major Modes
  ;; and Eglot have already populated the list with their defaults.
  (add-hook 'prog-mode-hook #'my/cape-capf-setup-super 100)
  (add-hook 'text-mode-hook #'my/cape-capf-setup-super 100)
  (add-hook 'eglot-managed-mode-hook #'my/cape-capf-setup-super 100))

(use-package corfu
  :defer t
  :custom
  (corfu-cycle t)
  (corfu-auto t)
  (corfu-quit-no-match 'separator)
  (corfu-preselect 'first)
  (corfu-auto-prefix 2)
  (corfu-auto-delay 0.2)
  :hook
  ((prog-mode . corfu-mode)
   (text-mode . corfu-mode))
  )

